DATABASE_URL=postgresql+psycopg2://kcpec:kcpec1234@localhost:5432/kcpec
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# https 로 서비스 중이면 반드시 true. 아직 http 로만 서비스 중이면 false로
# 둬야 브라우저가 로그인 쿠키를 저장한다.
COOKIE_SECURE=true
CORS_ORIGINS=["http://localhost:3000"]

# 프런트/백엔드 베이스 URL (소셜 OAuth callback 구성에 사용)
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# Toss Payments (비어 있으면 시뮬레이션 모드: 결제창 없이 즉시 paid 처리)
TOSS_SECRET_KEY=
TOSS_API_BASE=https://api.tosspayments.com

# 무통장 입금 안내 계좌
BANK_TRANSFER_ACCOUNT="기업은행 232-160450-04-015 (예금주: 한국범죄예방교육센터)"

# LLM (Gemini) — 비어 있으면 더미 초안
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# (legacy) Claude API — 현재 미사용, 추후 정리 예정
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 소셜 로그인 OAuth (B-flow). provider 별 미설정 시 자동 비활성.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (직원 의견서 검토 메일) — 미설정 시 콘솔 출력 모드
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STAFF_EMAIL=
