# --- 백엔드 API 베이스 URL ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- NextAuth v5 (lib/auth.ts) ---
AUTH_SECRET=please-change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- 카카오 OAuth (lib/auth.ts — 현재 비활성, 활성화 시 채우기) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 네이버 OAuth (lib/auth.ts — 현재 비활성) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 토스페이먼츠 (checkout/_client.tsx, counseling/ApplyButton.tsx) ---
# 비어있으면 카드/간편결제 결제 위젯이 비활성화되고 무통장 입금만 노출.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# --- 무통장 입금 안내 (checkout/pending/_client.tsx) ---
# 미설정 시 코드 내 기본값(기업은행 232-160450-04-015) 사용.
NEXT_PUBLIC_BANK_ACCOUNT=

# --- Google Analytics 4 (components/analytics/GA4.tsx) ---
# 비어있으면 GA4 스크립트가 렌더되지 않음.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
